{
  "manifest_version": 3,
  "name": "Butterfly",
  "version": "2.0",
  "description": "AI comment suggestions in your personal writing style, powered by Google Gemini.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content_linkedin.js"
      ],
      "css": [
        "content_styles.css"
      ],
      "exclude_matches": [
        "https://www.linkedin.com/in/*/recent-activity/comments/*"
      ]
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*/recent-activity/comments/*"
      ],
      "js": [
        "content_scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Butterfly"
  },
  "icons": {
    "128": "icon128.png"
  }
}
